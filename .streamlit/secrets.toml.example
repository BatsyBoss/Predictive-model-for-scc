# Copy this file to .streamlit/secrets.toml (same folder) and fill in real
# values. secrets.toml is gitignored — never commit real credentials.
#
# On Streamlit Community Cloud, paste the same key/value pairs into
# your app's Settings -> Secrets instead of uploading this file.

# Password required to unlock Admin Mode (dataset upload / retraining).
ADMIN_PASSWORD = "change-me"

# Optional — pre-fills the chatbot's API key field so users don't have to
# paste one in every session. Leave blank to require manual entry in the UI.
ANTHROPIC_API_KEY = ""
OPENAI_API_KEY = ""
